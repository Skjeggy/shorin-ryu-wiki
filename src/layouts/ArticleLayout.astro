---
import BaseLayout from './BaseLayout.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { getUI, type Lang, type SectionId } from '../i18n';

interface NavLink {
  title: string;
  slug: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  section: SectionId;
  rank?: string;
  tags?: string[];
  related?: string[];
  image?: string;
  video?: string;
  lang?: Lang;
  updated?: Date;
  prev?: NavLink;
  next?: NavLink;
  headings?: Heading[];
}

const {
  title,
  description,
  section,
  rank,
  tags = [],
  related = [],
  image,
  video,
  lang = 'nb',
  updated,
  prev,
  next,
  headings = [],
} = Astro.props;

// Build a privacy-friendly YouTube embed URL from any common YouTube link
// (watch?v=…, youtu.be/…, /embed/…) plus an optional ?t= start time.
function youtubeEmbed(url: string): string | undefined {
  try {
    const u = new URL(url);
    let id = '';
    if (u.hostname === 'youtu.be') {
      id = u.pathname.slice(1);
    } else if (u.pathname.startsWith('/embed/')) {
      id = u.pathname.split('/embed/')[1];
    } else {
      id = u.searchParams.get('v') ?? '';
    }
    if (!id) return undefined;
    const start = u.searchParams.get('t')?.replace('s', '');
    const query = start ? `?start=${start}` : '';
    return `https://www.youtube-nocookie.com/embed/${id}${query}`;
  } catch {
    return undefined;
  }
}

const videoEmbedUrl = video ? youtubeEmbed(video) : undefined;

const t = getUI(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sectionHref = `${base}/${lang}/${section}/`;
const formatter = new Intl.DateTimeFormat(lang === 'nb' ? 'nb-NO' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="flex gap-8">
    <article class="min-w-0 flex-1" data-pagefind-body>
    <nav class="text-sm text-ink-500 mb-4 not-prose dark:text-ink-400" aria-label="Breadcrumb">
      <a href={sectionHref} class="text-ink-500 hover:text-accent dark:text-ink-400 dark:hover:text-accent-light">
        <span aria-hidden="true">←</span> {t.article.backTo} {t.sections[section].title}
      </a>
    </nav>

    <header class="mb-8 not-prose">
      <p class="text-xs uppercase tracking-wider text-accent font-sans font-semibold mb-2 dark:text-accent-light">
        {t.sections[section].title}
        {rank && <span class="text-ink-500 dark:text-ink-400"> · {t.article.rank}: {rank}</span>}
      </p>
      <h1 class="text-3xl sm:text-4xl font-serif text-ink-900 leading-tight dark:text-ink-100">{title}</h1>
      {description && <p class="mt-3 text-lg text-ink-600 dark:text-ink-300">{description}</p>}
      {image && (
        <figure class="mt-6">
          <img src={`${base}${image}`} alt={title} class="rounded-lg border border-ink-200 dark:border-ink-700" />
        </figure>
      )}
      {videoEmbedUrl && (
        <div class="mt-6 aspect-video w-full overflow-hidden rounded-lg border border-ink-200 dark:border-ink-700">
          <iframe
            src={videoEmbedUrl}
            title={title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="h-full w-full"
          ></iframe>
        </div>
      )}
    </header>

    {headings.length > 1 && (
      <details class="mb-8 xl:hidden not-prose rounded-lg border border-ink-200 bg-white px-4 py-3 dark:border-ink-700 dark:bg-ink-800">
        <summary class="cursor-pointer text-xs uppercase tracking-wider text-ink-500 font-sans font-semibold dark:text-ink-400">
          {t.article.onThisPage}
        </summary>
        <ul class="mt-3 space-y-1 text-sm">
          {headings.map((h) => (
            <li class={h.depth === 3 ? 'ml-4' : ''}>
              <a href={`#${h.slug}`} class="text-ink-700 hover:text-accent no-underline dark:text-ink-300 dark:hover:text-accent-light">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <div class="prose prose-lg max-w-[70ch] dark:prose-invert">
      <slot />
    </div>

    {tags.length > 0 && (
      <div class="mt-10 not-prose">
        <span class="text-xs uppercase tracking-wider text-ink-500 font-sans font-semibold mr-2 dark:text-ink-400">
          {t.article.tags}:
        </span>
        <ul class="inline-flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="inline-block text-xs px-2 py-0.5 bg-ink-100 text-ink-700 rounded dark:bg-ink-800 dark:text-ink-300">
              {tag}
            </li>
          ))}
        </ul>
      </div>
    )}

    <RelatedArticles related={related} lang={lang} />

    {(prev || next) && (
      <nav class="mt-12 not-prose grid gap-3 sm:grid-cols-2 border-t border-ink-200 pt-6 dark:border-ink-700" aria-label={t.article.sectionNav}>
        {prev ? (
          <a href={`${sectionHref}${prev.slug}/`} class="card flex flex-col">
            <span class="text-xs uppercase tracking-wider text-ink-500 font-sans dark:text-ink-400">
              <span aria-hidden="true">←</span> {t.article.previous}
            </span>
            <span class="mt-1 text-ink-900 font-semibold dark:text-ink-100">{prev.title}</span>
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={`${sectionHref}${next.slug}/`} class="card flex flex-col sm:text-right">
            <span class="text-xs uppercase tracking-wider text-ink-500 font-sans dark:text-ink-400">
              {t.article.next} <span aria-hidden="true">→</span>
            </span>
            <span class="mt-1 text-ink-900 font-semibold dark:text-ink-100">{next.title}</span>
          </a>
        )}
      </nav>
    )}

    {updated && (
      <p class="mt-8 text-xs text-ink-500 not-prose dark:text-ink-400">
        {t.article.lastUpdated}: <time datetime={updated.toISOString()}>{formatter.format(updated)}</time>
      </p>
    )}
    </article>

    {headings.length > 1 && (
      <aside class="hidden xl:block w-56 shrink-0">
        <nav
          class="sticky top-[calc(var(--header-h,73px)+1.5rem)] max-h-[calc(100vh-var(--header-h,73px)-3rem)] overflow-y-auto"
          aria-label={t.article.onThisPage}
        >
          <p class="text-xs uppercase tracking-wider text-ink-500 font-sans font-semibold mb-3 dark:text-ink-400">
            {t.article.onThisPage}
          </p>
          <ul class="border-l border-ink-200 dark:border-ink-700">
            {headings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class:list={[
                    'block border-l-2 border-transparent -ml-px py-1 text-sm leading-snug text-ink-600 no-underline transition-colors hover:text-accent data-[active=true]:border-accent data-[active=true]:text-accent data-[active=true]:font-medium dark:text-ink-400 dark:hover:text-accent-light dark:data-[active=true]:border-accent-light dark:data-[active=true]:text-accent-light',
                    h.depth === 3 ? 'pl-6' : 'pl-3',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>

  <script>
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (links.length) {
      const map = new Map(links.map((l) => [l.getAttribute('data-toc-link'), l]));
      const targets = links
        .map((l) => document.getElementById(l.getAttribute('data-toc-link')))
        .filter((el) => el);
      let current = null;
      const setActive = (id) => {
        if (id === current) return;
        if (current) map.get(current)?.removeAttribute('data-active');
        current = id;
        if (id) map.get(id)?.setAttribute('data-active', 'true');
      };
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.target.offsetTop - b.target.offsetTop);
          if (visible.length) setActive(visible[0].target.id);
        },
        { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
      );
      targets.forEach((t) => observer.observe(t));
    }
  </script>
</BaseLayout>
