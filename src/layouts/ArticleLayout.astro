---
import BaseLayout from './BaseLayout.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { getUI, type Lang, type SectionId } from '../i18n';

interface NavLink {
  title: string;
  slug: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  section: SectionId;
  rank?: string;
  tags?: string[];
  related?: string[];
  image?: string;
  video?: string;
  lang?: Lang;
  updated?: Date;
  prev?: NavLink;
  next?: NavLink;
  headings?: Heading[];
}

const {
  title,
  description,
  section,
  rank,
  tags = [],
  related = [],
  image,
  video,
  lang = 'nb',
  updated,
  prev,
  next,
  headings = [],
} = Astro.props;

// Build a privacy-friendly YouTube embed URL from any common YouTube link
// (watch?v=…, youtu.be/…, /embed/…) plus an optional ?t= start time.
function youtubeEmbed(url: string): string | undefined {
  try {
    const u = new URL(url);
    let id = '';
    if (u.hostname === 'youtu.be') {
      id = u.pathname.slice(1);
    } else if (u.pathname.startsWith('/embed/')) {
      id = u.pathname.split('/embed/')[1];
    } else {
      id = u.searchParams.get('v') ?? '';
    }
    if (!id) return undefined;
    const start = u.searchParams.get('t')?.replace('s', '');
    const query = start ? `?start=${start}` : '';
    return `https://www.youtube-nocookie.com/embed/${id}${query}`;
  } catch {
    return undefined;
  }
}

const videoEmbedUrl = video ? youtubeEmbed(video) : undefined;

const t = getUI(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sectionHref = `${base}/${lang}/${section}/`;
const formatter = new Intl.DateTimeFormat(lang === 'nb' ? 'nb-NO' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} lang={lang}>
  <article data-pagefind-body>
    <nav class="text-sm text-ink-500 mb-4 not-prose" aria-label="Breadcrumb">
      <a href={sectionHref} class="text-ink-500 hover:text-accent">
        <span aria-hidden="true">←</span> {t.article.backTo} {t.sections[section].title}
      </a>
    </nav>

    <header class="mb-8 not-prose">
      <p class="text-xs uppercase tracking-wider text-accent font-sans font-semibold mb-2">
        {t.sections[section].title}
        {rank && <span class="text-ink-500"> · {t.article.rank}: {rank}</span>}
      </p>
      <h1 class="text-3xl sm:text-4xl font-serif text-ink-900 leading-tight">{title}</h1>
      {description && <p class="mt-3 text-lg text-ink-600">{description}</p>}
      {image && (
        <figure class="mt-6">
          <img src={`${base}${image}`} alt={title} class="rounded-lg border border-ink-200" />
        </figure>
      )}
      {videoEmbedUrl && (
        <div class="mt-6 aspect-video w-full overflow-hidden rounded-lg border border-ink-200">
          <iframe
            src={videoEmbedUrl}
            title={title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="h-full w-full"
          ></iframe>
        </div>
      )}
    </header>

    {headings.length > 1 && (
      <details class="mb-8 not-prose rounded-lg border border-ink-200 bg-white px-4 py-3">
        <summary class="cursor-pointer text-xs uppercase tracking-wider text-ink-500 font-sans font-semibold">
          {t.article.onThisPage}
        </summary>
        <ul class="mt-3 space-y-1 text-sm">
          {headings.map((h) => (
            <li class={h.depth === 3 ? 'ml-4' : ''}>
              <a href={`#${h.slug}`} class="text-ink-700 hover:text-accent no-underline">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    {tags.length > 0 && (
      <div class="mt-10 not-prose">
        <span class="text-xs uppercase tracking-wider text-ink-500 font-sans font-semibold mr-2">
          {t.article.tags}:
        </span>
        <ul class="inline-flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="inline-block text-xs px-2 py-0.5 bg-ink-100 text-ink-700 rounded">
              {tag}
            </li>
          ))}
        </ul>
      </div>
    )}

    <RelatedArticles related={related} lang={lang} />

    {(prev || next) && (
      <nav class="mt-12 not-prose grid gap-3 sm:grid-cols-2 border-t border-ink-200 pt-6" aria-label={t.article.sectionNav}>
        {prev ? (
          <a href={`${sectionHref}${prev.slug}/`} class="card flex flex-col">
            <span class="text-xs uppercase tracking-wider text-ink-500 font-sans">
              <span aria-hidden="true">←</span> {t.article.previous}
            </span>
            <span class="mt-1 text-ink-900 font-semibold">{prev.title}</span>
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={`${sectionHref}${next.slug}/`} class="card flex flex-col sm:text-right">
            <span class="text-xs uppercase tracking-wider text-ink-500 font-sans">
              {t.article.next} <span aria-hidden="true">→</span>
            </span>
            <span class="mt-1 text-ink-900 font-semibold">{next.title}</span>
          </a>
        )}
      </nav>
    )}

    {updated && (
      <p class="mt-8 text-xs text-ink-500 not-prose">
        {t.article.lastUpdated}: <time datetime={updated.toISOString()}>{formatter.format(updated)}</time>
      </p>
    )}
  </article>
</BaseLayout>
