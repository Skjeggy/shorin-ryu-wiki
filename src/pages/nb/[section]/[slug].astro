---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { sectionOrder, type SectionId } from '../../../i18n';

const lang = 'nb';

type AnyEntry =
  | CollectionEntry<'ranks'>
  | CollectionEntry<'kata'>
  | CollectionEntry<'techniques'>
  | CollectionEntry<'bunkai'>
  | CollectionEntry<'randori'>
  | CollectionEntry<'training-sessions'>
  | CollectionEntry<'ressurser'>;

export async function getStaticPaths() {
  const sections: SectionId[] = [
    'ranks',
    'kata',
    'techniques',
    'bunkai',
    'randori',
    'training-sessions',
    'ressurser',
  ];
  const all = await Promise.all(
    sections.map(async (section) => {
      const entries = (await getCollection(section, ({ data }) => data.lang === 'nb'))
        .slice()
        .sort((a, b) => {
          const ao = a.data.order ?? 999;
          const bo = b.data.order ?? 999;
          if (ao !== bo) return ao - bo;
          return a.data.title.localeCompare(b.data.title, 'nb');
        });
      return entries.map((entry, i) => {
        const prevEntry = entries[i - 1];
        const nextEntry = entries[i + 1];
        const toNav = (e?: (typeof entries)[number]) =>
          e ? { title: e.data.title, slug: e.slug } : undefined;
        return {
          params: { section, slug: entry.slug },
          props: { entry, prev: toNav(prevEntry), next: toNav(nextEntry) },
        };
      });
    })
  );
  return all.flat();
}

interface NavLink {
  title: string;
  slug: string;
}

interface Props {
  entry: AnyEntry;
  prev?: NavLink;
  next?: NavLink;
}

const { entry, prev, next } = Astro.props;
if (!sectionOrder.includes(entry.data.section)) {
  throw new Error(`Unknown section in entry: ${entry.data.section}`);
}
const { Content, headings } = await entry.render();
const data = entry.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<ArticleLayout
  title={data.title}
  description={data.description}
  section={data.section as SectionId}
  rank={'rank' in data ? data.rank : undefined}
  tags={data.tags}
  related={data.related}
  image={data.image}
  video={'video' in data ? data.video : undefined}
  lang={lang}
  updated={data.updated}
  prev={prev}
  next={next}
  headings={toc}
>
  <Content />
</ArticleLayout>
